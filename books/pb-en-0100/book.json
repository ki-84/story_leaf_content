    {
      "index": 0,
      "imagePath": "images/02.jpg",
      "text": "I am a big boy now."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "I can climb up the steps."
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "But I cannot climb down again."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "I can climb on a chair."
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "But I cannot climb down again."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "I climb on to the chair, and then on the table!"
    },
    {
      "index": 6,
      "imagePath": "images/08.jpg",
      "text": "But I cannot climb down again."
    },
    {
      "index": 7,
      "imagePath": "images/09.jpg",
      "text": "“Papa! Papa!” I shout.\n\nPapa laughs. “Sonu, learn to climb down!” he says."
    },
    {
      "index": 8,
      "imagePath": "images/10.jpg",
      "text": "I am afraid. But I do not cry."
    },
    {
      "index": 9,
      "imagePath": "images/11.jpg",
      "text": "Slowly, I get down from the table, and down from the chair."
    },
    {
      "index": 10,
      "imagePath": "images/12.jpg",
      "text": "At last, I have learnt to climb down too!"
    }
  ]
