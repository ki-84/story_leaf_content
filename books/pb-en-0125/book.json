  "pages": [
    {
      "index": 0,
      "imagePath": "images/02.jpg",
      "text": "I have a friend. She lives in my house."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "When I am happy, so is she."
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "When I cry, she cries too."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "But I cannot hear her voice. My friend lives inside the mirror."
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "“Come out,” I tell her, “we will play.” She does not come out."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "I am not happy. I go to sleep."
    },
    {
      "index": 6,
      "imagePath": "images/08.jpg",
      "text": "She comes out of the mirror in my sleep! And we have fun."
    },
    {
      "index": 7,
      "imagePath": "images/09.jpg",
      "text": "We play, we run, we shout and scream together."
    },
    {
      "index": 8,
      "imagePath": "images/10.jpg",
      "text": "When I talk to her, she also talks to me."
    },
    {
      "index": 9,
      "imagePath": "images/11.jpg",
      "text": "In the morning, my friend will go back into the mirror."
    },
    {
      "index": 10,
      "imagePath": "images/12.jpg",
      "text": "But I don't mind at all. We will play again in my dreams!"
    }
  ]
}