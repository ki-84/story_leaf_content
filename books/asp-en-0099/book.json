  "pages": [
    {
      "index": 0,
      "imagePath": "images/02.jpg",
      "text": "This is Azizi.\nAzizi is my doll."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "I like Azizi because he\nalways smiles."
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "After I wake up I wash\nmy face.\nThen I look for Azizi."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "When I find Azizi I brush\nhis hair."
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "When I eat breakfast I\nfeed Azizi."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "When I eat sweets I\ngive one to Azizi."
    },
    {
      "index": 6,
      "imagePath": "images/08.jpg",
      "text": "But Azizi never eats his\nsweet.\nI wonder why!"
    },
    {
      "index": 7,
      "imagePath": "images/09.jpg",
      "text": "I walk around the\ncompound picking\nflowers."
    },
    {
      "index": 8,
      "imagePath": "images/10.jpg",
      "text": "I give a flower to Azizi.\nBut he never says,\n\"Thank you.\""
    },
    {
      "index": 9,
      "imagePath": "images/11.jpg",
      "text": "I wash Azizi clean\nbefore my mother\nbathes me."
    },
    {
      "index": 10,
      "imagePath": "images/12.jpg",
      "text": "I dress Azizi in red\nbecause I love the\ncolour red."
    },
    {
      "index": 11,
      "imagePath": "images/13.jpg",
      "text": "When I go to sleep, I lay\nAzizi beside me."
    }
  ]
}