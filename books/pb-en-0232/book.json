      "imagePath": "images/02.jpg",
      "text": "My best friend lives with me. When I look in the mirror, she looks at me."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "When I am happy, she is too."
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "When I am sad, she is too."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "Me and my friend play all day long until we are tired."
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "We play in my dream when I am asleep."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "Me and my friend live together forever."
    }
  ]
}