    {
      "index": 0,
      "imagePath": "images/02.jpg",
      "text": "A fawn was racing in the forest."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "He was ahead of the rabbit."
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "He was ahead of the elephant."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "He leapt and cleared the stream."
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "He ran past the crumbling wall."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "There was a large boulder on the grassy plain. He stumbled and fell down."
    },
    {
      "index": 6,
      "imagePath": "images/08.jpg",
      "text": "He burst into tears."
    },
    {
      "index": 7,
      "imagePath": "images/09.jpg",
      "text": "The monkey massaged his leg. Tears flowed from the fawn's eyes."
    },
    {
      "index": 8,
      "imagePath": "images/10.jpg",
      "text": "Brother Bear picked him up. The fawn didn't stop crying."
    },
    {
      "index": 9,
      "imagePath": "images/11.jpg",
      "text": "His mother came. She said, “Look, we'll beat up this bad boulder!”"
    },
    {
      "index": 10,
      "imagePath": "images/12.jpg",
      "text": "The fawn said, “Oh, don't do that or he will also start crying.” His mother laughed. So did the fawn."
    }
  ]
