      "index": 0,
      "imagePath": "images/02.jpg",
      "text": "Tingi lived with his grandmother."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "He used to look after the cows with her."
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "One day the soldiers came."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "They took the cows away."
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "Tingi and his grandmother ran away and hid."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "They hid in the bush until night."
    },
    {
      "index": 6,
      "imagePath": "images/08.jpg",
      "text": "Then the soldiers came back."
    },
    {
      "index": 7,
      "imagePath": "images/09.jpg",
      "text": "Grandmother hid Tingi under the leaves."
    },
    {
      "index": 8,
      "imagePath": "images/10.jpg",
      "text": "One of the soldiers put his foot right on him, but he kept quiet."
    },
    {
      "index": 9,
      "imagePath": "images/11.jpg",
      "text": "When it was safe, Tingi and his grandmother came out."
    },
    {
      "index": 10,
      "imagePath": "images/12.jpg",
      "text": "They crept home very quietly."
    }
