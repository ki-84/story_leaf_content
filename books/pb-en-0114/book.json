    {
      "index": 0,
      "imagePath": "images/02.jpg",
      "text": "I am a big girl. I go out of the house alone."
    },
    {
      "index": 1,
      "imagePath": "images/03.jpg",
      "text": "It is so dark! Is someone there? Who is it?"
    },
    {
      "index": 2,
      "imagePath": "images/04.jpg",
      "text": "Oh, it is only the cat. I am not afraid."
    },
    {
      "index": 3,
      "imagePath": "images/05.jpg",
      "text": "I can see a big dark thing outside! What is it?"
    },
    {
      "index": 4,
      "imagePath": "images/06.jpg",
      "text": "Oh, it is only the well. I am not afraid."
    },
    {
      "index": 5,
      "imagePath": "images/07.jpg",
      "text": "And that sound! Creak creak creak! What is it?"
    },
    {
      "index": 6,
      "imagePath": "images/08.jpg",
      "text": "Only my sister drawing water from the well! I am not afraid."
    },
    {
      "index": 7,
      "imagePath": "images/09.jpg",
      "text": "I hear footsteps! Who is it? Who is it?"
    },
    {
      "index": 8,
      "imagePath": "images/10.jpg",
      "text": "It is my mother. She has come home from the fields."
    },
    {
      "index": 9,
      "imagePath": "images/11.jpg",
      "text": "I am a big girl now."
    },
    {
      "index": 10,
      "imagePath": "images/12.jpg",
      "text": "I am not afraid of anything!"
    }
  ]
